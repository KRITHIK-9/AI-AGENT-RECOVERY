# ---------------------------------------------------------------- Gemini agent (optional)
# Leave empty to run with the deterministic rule engine. Get a key at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Maximum Gemini calls per pipeline run (cost / latency control); after that the rule engine decides
LLM_MAX_CALLS_PER_RUN=300

# ---------------------------------------------------------------- Payment provider
# simulation (default)  : offline probabilistic simulator, no network
# razorpay_test         : creates Razorpay TEST-MODE orders / payment links (rzp_test_ keys only);
#                         recovery outcomes are still simulated
PAYMENT_PROVIDER=simulation
SIMULATION_SEED=42
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MAX_API_CALLS=25
RAZORPAY_CURRENCY=INR

# ---------------------------------------------------------------- ML settings
# strict  : exclude post-outcome fields (gateway_status, authentication_status, retry_count)
# lenient : keep retry_count (only if your data records retries made BEFORE the current attempt)
LEAKAGE_MODE=strict
RISK_LOW_THRESHOLD=0.30
RISK_HIGH_THRESHOLD=0.70

# ---------------------------------------------------------------- Storage & servers
DATABASE_URL=sqlite:///./recoverai.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
